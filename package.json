{
  "name": "developerportfolio",
  "version": "0.0.0",
  "private": true,
  "description": "个人作品集网站，基于 React、TypeScript、Vite 和 Tailwind CSS 构建。",
  "type": "module",
  "scripts": {
    "build": "tsc -p config/json/tsconfig.json && vite --config config/js/vite.config.ts build",
    "deploy": "gh-pages -d dist",
    "dev": "vite --config config/js/vite.config.ts",
    "preview": "vite preview --config config/js/vite.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Breezesouth/AI-.git"
  },
  "homepage": "https://breezesouth.github.io/AI-/",
  "author": "Breezesouth",
  "license": "MIT",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.5",
    "typescript": "^5.6.2",
    "vite": "^5.4.1"
  }
}
